VQI_DATA_DIR=./data
VQI_MAX_DURATION_SECONDS=5400
VQI_RETENTION_HOURS=24
VQI_WORKER_COUNT=1
VQI_DIRECT_DOWNLOAD_CONNECTIONS=8
VQI_YOUTUBE_CONCURRENT_FRAGMENTS=8
VQI_MAX_REMOTE_BYTES=12884901888
